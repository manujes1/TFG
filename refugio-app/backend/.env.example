PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/refugio_db?schema=public"
JWT_SECRET="genera-una-cadena-aleatoria-larga"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# --- IA ---
# Proveedor activo: "ollama" (local) o "gemini" (API de Google)
IA_PROVIDER="ollama"
# Proveedor de respaldo si el principal falla (opcional, vacío = sin fallback).
# Ejemplo: IA_PROVIDER="gemini" con IA_FALLBACK_PROVIDER="ollama"
IA_FALLBACK_PROVIDER=""

# Matchmaking: "determinista" (reglas, reproducible) o "llm" (Gemini puntúa).
# "llm" solo se aplica si IA_PROVIDER="gemini"; si Gemini falla, se usan las reglas.
MATCHMAKING_MODE="determinista"

# Ollama
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_MS=180000

# Gemini (la clave solo se usa en el backend; no la subas al repositorio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Opcional: nivel de razonamiento (low, medium, high; "minimal" solo en algunos modelos)
GEMINI_THINKING_LEVEL=""
IA_TIMEOUT_MS=30000
